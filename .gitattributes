# Normalize repository-owned text while keeping Unity YAML deterministic.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.ps1 text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.txt text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve the byte-level EOL contract used by imported package checksums.
ArtProduction/IdleMedievalLegends_Task*/**/*.csv text eol=crlf
ArtProduction/IdleMedievalLegends_Task014_VisualBible/Examples/MONSTER_FACTIONS_ROSTER.csv text eol=lf
ArtProduction/IdleMedievalLegends_Task015_AssetCatalog/Examples/MONSTER_FACTIONS_ROSTER.csv text eol=lf
ArtProduction/IdleMedievalLegends_Task015_AssetCatalog/SHA256SUMS.txt text eol=crlf
ArtProduction/IdleMedievalLegends_Task019_MeshyOperations/SHA256SUMS.txt text eol=crlf

# Existing Git LFS rules for source art and large media.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
